# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Supply and Demand Forecasting"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# CORS configuration (allowed frontend origins, JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Session & Storage Settings (Temporary session storage without persistent DB)
SESSION_EXPIRY_MINUTES=60
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=15
MAX_UPLOAD_SIZE_MB=25

# Storage Directories & Ingestion Constraints
STORAGE_DIR="temp_storage/datasets"
SESSION_STORAGE_DIR="temp_storage/sessions"
MAX_ROWS=1000000
MIN_ROWS=1
MAX_COLS=200
MIN_COLS=2
PREVIEW_ROWS=5

# ==========================================
# Optional Natural-Language Interpretation (LLM)
# ==========================================
# LLM integration remains completely optional and disabled by default.
LLM_ENABLED=False
LLM_PROVIDER="none"
LLM_API_KEY="your_optional_api_key_placeholder"
LLM_MODEL="gpt-4o-mini"

# ==========================================
# Administrator Authentication
# ==========================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="demandiq_admin_2026"
